# Copier vers .env (à la racine du dossier php/)

APP_NAME=Yombal Market
APP_URL=https://votredomaine.com
APP_SECRET=changez-moi-en-production-long-et-aleatoire
APP_DEBUG=0

# MySQL Hostinger (hPanel → Bases de données MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yombal_market
DB_USER=root
DB_PASS=

# E-mails admin (séparés par des virgules)
ADMIN_EMAILS=compta@universdiasporas.com
CONTACT_EMAIL=compta@universdiasporas.com

# Mot de passe initial admin (utilisé par scripts/bootstrap_admin.php)
BOOTSTRAP_ADMIN_PASSWORD=

# Stripe (optionnel)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paiement manuel
BANK_NAME=
BANK_HOLDER=
BANK_IBAN=
BANK_BIC=
PAYPAL_EMAIL=
PAYPAL_ME_URL=

# Simulation paiement (0 en production)
PAYMENT_SIMULATION=0

# Conseiller boutique (1 = activé, mode local sans OpenAI)
ASSISTANT_ENABLED=1

# SMTP Hostinger
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Livraison internationale (centimes)
INTERNATIONAL_SHIPPING_CENTS=1490
